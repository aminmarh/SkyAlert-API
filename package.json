{
    "scripts": {
        "prepare": "husky install",
        "commit": "git-cz",
        "clean": "black . && flake8 . && prettier --write \"**/*.{js,css,html,json,md}\""
    },
    "devDependencies": {
        "@commitlint/cli": "^19.6.0",
        "@commitlint/config-conventional": "^19.6.0",
        "cz-conventional-changelog": "^3.3.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.2.11"
    },
    "lint-staged": {
        "*.py": [
            "black",
            "flake8"
        ],
        "*.js": [
            "prettier --write"
        ]
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    }
}
